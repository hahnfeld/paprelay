<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Finding and talking to the machine. Scan results are never used to infer location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      The background scheduler brings these with it. PAPRelay never asks it to wait for a
      network or to run as a foreground service, so both are taken out again: the app has no
      use for knowing whether the phone is online. What stays is the scheduler's permission to
      keep the phone awake for the length of a run and to put its schedule back after a restart.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- Health Connect: write-only. PAPRelay never reads other apps' health data. -->
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" />

    <!-- PAPRelay has no network access. If a library ever asks for it, the build drops the request. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <application
        android:name=".PapRelayApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PAPRelay"
        tools:ignore="UnusedAttribute">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Told by the system, and by nothing else, when the paired machine is heard in range. -->
        <receiver
            android:name=".ble.PresenceReceiver"
            android:exported="false" />

        <!-- The privacy text. Reached only through the alias below, which the system guards. -->
        <activity
            android:name=".ui.PrivacyActivity"
            android:exported="false" />

        <!-- Health Connect opens this to show why PAPRelay asks for its permissions. -->
        <!-- Serves the separate Health Connect app on Android 13 and older. PAPRelay runs on
             Android 14+, where Health Connect is part of the system, so it is not shipped. -->
        <service
            android:name="androidx.health.platform.client.impl.sdkservice.HealthDataSdkService"
            tools:node="remove" />

        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".ui.PrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
